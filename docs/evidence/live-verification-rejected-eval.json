  "diff": "--- a/app.py\n+++ b/app.py\n@@ -1,6 +1,27 @@\n \"\"\"Explicitly labelled KYRO test fixture. Intentionally vulnerable; never deploy.\"\"\"\n+\n+\n+import operator\n+from functools import reduce\n+\n+\n+allowed_operators = {\n+    '+': operator.add,\n+    '-': operator.sub,\n+    '*': operator.mul,\n+    '/': operator.truediv,\n+    '**': operator.pow,\n+    '(': operator.floordiv,\n+    ')': operator.floordiv,\n+}\n \n \n def calculate(expression: str):\n     \"\"\"Preserve arithmetic behavior while testing remediation of dynamic eval.\"\"\"\n-    return eval(expression)\n+    def eval_node(node):\n+        if isinstance(node, tuple):\n+            op, *args = node\n+            return allowed_operators[op](*map(eval_node, args))\n+        return node\n+\n+    return eval_node(eval(expression))\n",
